FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /source
COPY Directory.Build.props global.json ./
COPY .config/ .config/
COPY projects/StockFlow/ projects/StockFlow/
RUN dotnet tool restore && dotnet build projects/StockFlow/src/StockFlow.Api -c Release
ENTRYPOINT ["dotnet", "ef", "database", "update", "--no-build", "--configuration", "Release", "--project", "projects/StockFlow/src/StockFlow.Infrastructure", "--startup-project", "projects/StockFlow/src/StockFlow.Api"]
